APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://tyde:CHANGE_ME@127.0.0.1:5432/tyde_outside
SMS_PROVIDER=mock
CODE_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info

# 文件存储：默认 disabled；仅配置新项目专用 OSS，不复用旧 Apollo/bucket。
# 上传/查看等接口已接入；OSS 真实联调待完成，已认领项目/考试附件权限尚待业务回补。
FILE_STORAGE_PROVIDER=disabled
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
TYDE_FILE_MAX_SIZE=52428800
# 新配置使用字节整数，不支持旧配置的 100MB 字符串。
TYDE_UPLOAD_MAX_REQUEST_SIZE=104857600
TYDE_FILE_MAX_BATCH=10
TYDE_FILE_URL_EXPIRE=604800
TYDE_FILE_UNCLAIMED_EXPIRE=86400
TYDE_FILE_RELEASED_EXPIRE=86400
TYDE_FILE_CLEANUP_BATCH=100
