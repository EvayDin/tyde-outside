APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://tyde:CHANGE_ME@127.0.0.1:5432/tyde_outside
SMS_PROVIDER=mock
CODE_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
# 桌面安装包来源；开发时按实际端口追加回环 HTTP(S) 源，不允许通配或任意远程来源。
DESKTOP_ORIGINS=tyde-app://app
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info

# 文件存储：默认 disabled；启用时只在后端环境配置密钥。
# 当前项目用户指定 bucket 为 lsh-oss-agi-tool-platform；不导入旧台账、不操作既有对象。
FILE_STORAGE_PROVIDER=disabled
# 阿里云同区域内网部署用下方端点；本机/Vercel 改为 https://oss-cn-shanghai.aliyuncs.com。
OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
# 面向客户端下载的签名链接；省略时从 OSS_ENDPOINT 推导同区域外网端点。
OSS_PUBLIC_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# 项目物理主目录固定为 bucket 下的 tyde/，由存储适配器统一添加。
OSS_BUCKET=lsh-oss-agi-tool-platform
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
TYDE_FILE_MAX_SIZE=52428800
# 新配置使用字节整数，不支持旧配置的 100MB 字符串。
TYDE_UPLOAD_MAX_REQUEST_SIZE=104857600
TYDE_FILE_MAX_BATCH=10
TYDE_FILE_URL_EXPIRE=604800
TYDE_FILE_UNCLAIMED_EXPIRE=86400
TYDE_FILE_RELEASED_EXPIRE=86400
TYDE_FILE_CLEANUP_BATCH=100
