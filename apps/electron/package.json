{
  "name": "@tyde/electron",
  "version": "0.1.0",
  "description": "tyde 内部试用客户端",
  "author": "tyde",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package:mac": "node ../../scripts/prepare-electron.mjs mac && electron-builder --mac --universal --publish never && node ../../scripts/checksums.mjs ../../release",
    "package:win": "node ../../scripts/prepare-electron.mjs win && electron-builder --win --x64 --publish never && node ../../scripts/checksums.mjs ../../release"
  },
  "dependencies": {
    "@tyde/shared": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.0",
    "vite": "7.3.6"
  }
}
